# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit source and configuration files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Ensure golden fixtures remain byte-consistent across all OS checkouts
tests/fixtures/** text eol=lf
